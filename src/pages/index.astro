---
import { getImage } from "astro:assets";

import meDesktop from "../static/me.jpg";
import meMobile from "../static/me_cropped.jpg";
import Link from "../components/link.astro";
import MainLayout from "../layouts/main.astro";

const portraitDesktop = await getImage({
	src: meDesktop,
	format: "avif",
	width: 760,
	height: 1060,
	densities: [1, 1.5],
});
const portraitDesktopFallback = await getImage({
	src: meDesktop,
	format: "jpg",
	width: 760,
	height: 1060,
	densities: [1, 1.5],
});
const portraitDesktopZoom = await getImage({
	src: meDesktop,
	format: "avif",
	width: 1024,
	height: 1428,
});
const portraitDesktopZoomFallback = await getImage({
	src: meDesktop,
	format: "jpg",
	width: 1024,
	height: 1428,
});
const portraitMobile = await getImage({
	src: meMobile,
	format: "avif",
	width: 640,
	height: 640,
	densities: [1, 2],
});
const portraitMobileFallback = await getImage({
	src: meMobile,
	format: "jpg",
	width: 640,
	height: 640,
	densities: [1, 2],
});
const portraitMobileZoom = await getImage({
	src: meMobile,
	format: "avif",
	width: 1024,
	height: 1024,
});
const portraitMobileZoomFallback = await getImage({
	src: meMobile,
	format: "jpg",
	width: 1024,
	height: 1024,
});

const links = [
	{
		label: "GitHub",
		href: "https://github.com/MrFlashAccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "X",
		href: "https://twitter.com/mrflashaccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "Telegram",
		href: "https://t.me/mrflashaccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "CV",
		href: "/cv.pdf",
		download: "Sergei Garin CV.pdf",
	},
	{
		label: "Email",
		href: "mailto:job@garin.dev",
		itemProp: "email",
	},
];
---

<MainLayout>
	<main
		class="min-h-[100dvh] w-full overflow-x-hidden bg-[#080807] text-[#f5f0e8]"
	>
		<section
			class="pb-safe xl:px-20 relative isolate mx-auto min-h-[100dvh] w-full max-w-[1240px] overflow-hidden px-6 py-8 sm:px-8 md:px-12 md:py-10 lg:px-16 lg:py-14"
			aria-labelledby="identity-title"
		>
			<picture
				class="pointer-events-none absolute inset-x-0 top-0 block lg:hidden"
				aria-hidden="true"
				data-zoom-picture
				data-zoom-threshold="2.25"
			>
				<source srcset={portraitMobile.srcSet.attribute} type="image/avif" />
				<source
					srcset={portraitMobileFallback.srcSet.attribute}
					type="image/jpeg"
				/>
				<img
					class="absolute right-[-18%] top-[-0.5rem] h-[46dvh] min-h-[19rem] w-auto max-w-none object-contain object-top opacity-[0.88] brightness-[1.1] contrast-[1.02] saturate-[0.9] sm:right-[-8%] sm:h-[49dvh] md:right-[-2%] md:h-[53dvh]"
					src={portraitMobileFallback.src}
					alt=""
					width={portraitMobileFallback.attributes.width}
					height={portraitMobileFallback.attributes.height}
					loading="eager"
					decoding="async"
				/>
				<template>
					<source srcset={portraitMobileZoom.src} type="image/avif" />
					<source srcset={portraitMobileZoomFallback.src} type="image/jpeg" />
				</template>
			</picture>

			<picture
				class="pointer-events-none absolute inset-0 hidden lg:block"
				aria-hidden="true"
				data-zoom-picture
				data-zoom-threshold="1.75"
			>
				<source srcset={portraitDesktop.srcSet.attribute} type="image/avif" />
				<source
					srcset={portraitDesktopFallback.srcSet.attribute}
					type="image/jpeg"
				/>
				<img
					class="xl:right-[4%] absolute bottom-[-2%] right-[1%] top-auto h-[104%] w-auto max-w-none object-contain opacity-[0.94] brightness-[1.14] contrast-[1.03] saturate-[0.92]"
					src={portraitDesktopFallback.src}
					alt=""
					width={portraitDesktopFallback.attributes.width}
					height={portraitDesktopFallback.attributes.height}
					loading="eager"
					decoding="async"
				/>
				<template>
					<source srcset={portraitDesktopZoom.src} type="image/avif" />
					<source srcset={portraitDesktopZoomFallback.src} type="image/jpeg" />
				</template>
			</picture>

			<script is:inline>
				const root = document.currentScript?.parentElement;
				const pictures = Array.from(
					root?.querySelectorAll("[data-zoom-picture]") ?? [],
				);

				if (pictures.length > 0) {
					const abortController = new AbortController();
					const maybeUpgradePictures = () => {
						const scale = window.visualViewport?.scale ?? 1;
						const effectivePixelRatio = (window.devicePixelRatio || 1) * scale;

						for (const picture of pictures) {
							if (!(picture instanceof HTMLPictureElement)) {
								continue;
							}

							const template = picture.querySelector("template");
							if (!(template instanceof HTMLTemplateElement)) {
								continue;
							}

							const threshold = Number(picture.dataset.zoomThreshold || 2);
							if (effectivePixelRatio < threshold) {
								continue;
							}

							picture.prepend(template.content.cloneNode(true));
							template.remove();
						}

						if (
							pictures.every((picture) => !picture.querySelector("template"))
						) {
							abortController.abort();
						}
					};

					maybeUpgradePictures();
					window.visualViewport?.addEventListener(
						"resize",
						maybeUpgradePictures,
						{ passive: true, signal: abortController.signal },
					);
					window.addEventListener("resize", maybeUpgradePictures, {
						passive: true,
						signal: abortController.signal,
					});
				}
			</script>

			<div
				class="absolute inset-0 bg-[linear-gradient(180deg,rgba(8,8,7,0)_0%,rgba(8,8,7,0.08)_22%,rgba(8,8,7,0.42)_54%,#080807_82%)] sm:bg-[linear-gradient(180deg,rgba(8,8,7,0)_0%,rgba(8,8,7,0.12)_26%,rgba(8,8,7,0.44)_56%,#080807_80%)] lg:bg-[linear-gradient(90deg,#080807_0%,rgba(8,8,7,0.92)_31%,rgba(8,8,7,0.36)_58%,rgba(8,8,7,0)_100%)]"
				aria-hidden="true"
			>
			</div>

			<div
				class="relative z-10 flex min-h-[calc(100dvh-4rem)] max-w-[21rem] flex-col justify-end pb-2 pt-[38dvh] sm:max-w-[24rem] sm:pt-[40dvh] md:min-h-[calc(100dvh-5rem)] md:max-w-[31rem] md:pt-[42dvh] lg:min-h-[calc(100dvh-7rem)] lg:max-w-[46rem] lg:justify-center lg:pb-0 lg:pt-0"
			>
				<h1
					id="identity-title"
					class="max-w-[9.2ch] text-[clamp(4.15rem,18vw,6.4rem)] font-normal leading-[0.98] tracking-[-0.065em] text-[#fbf5eb] lg:text-[clamp(6.8rem,9.4vw,10.8rem)] lg:leading-[1]"
					itemprop="name"
				>
					<span itemprop="givenName">Sergei</span>
					<span class="block" itemprop="familyName">Garin</span>
				</h1>

				<p
					class="mt-6 max-w-[20rem] text-[clamp(1.18rem,4.8vw,1.72rem)] font-normal leading-[1.18] tracking-[-0.04em] text-[#f0e7d8] md:mt-7 md:max-w-[34rem] lg:max-w-[37rem] lg:text-[clamp(1.55rem,2.2vw,2.15rem)] lg:leading-[1.16]"
				>
					Frontend engineer for sharp, reliable product interfaces.
				</p>

				<p
					class="mt-3 max-w-[20rem] text-[0.98rem] leading-7 tracking-[-0.02em] text-[#d8cdbc] md:mt-4 md:max-w-[31rem] md:text-lg md:leading-8"
				>
					I turn messy product ideas into calm, fast,
					<span class="whitespace-nowrap">production-ready UI.</span>
				</p>

				<nav class="mt-7 self-start md:mt-9" aria-label="Contact links">
					<ul
						class="flex max-w-[20rem] list-none flex-wrap items-center justify-start border-y border-[#d8cdbc]/20 py-3.5 text-left text-sm font-normal tracking-[-0.015em] text-[#eee4d4] md:max-w-none md:gap-y-3 md:border-0 md:py-0 md:text-base"
					>
						{
							links.map((link, index) => (
								<li class="flex items-center">
									{index > 0 && (
										<span
											class="mx-2 h-3 w-px bg-[#d8cdbc]/35 md:mx-3 md:h-4"
											aria-hidden="true"
										/>
									)}
									<Link
										href={link.href}
										rel={link.rel}
										itemProp={link.itemProp}
										download={link.download}
										class="identity-link block py-1.5 text-[#f5ecdc] no-underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color,transform] duration-200 hover:-translate-y-px hover:text-white hover:underline hover:decoration-[#f5ecdc] focus-visible:ring-[#f5ecdc] focus-visible:ring-offset-[#080807] active:translate-y-0 md:inline-block md:px-1 md:py-0.5"
									>
										{link.label}
									</Link>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</section>
	</main>
</MainLayout>
