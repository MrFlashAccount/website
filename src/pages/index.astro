---
import { getImage } from "astro:assets";

import me from "../static/me.jpg";
import Link from "../components/link.astro";
import MainLayout from "../layouts/main.astro";

const portraitDesktop = await getImage({
	src: me,
	format: "avif",
	width: 760,
	height: 1060,
	densities: [1, 1.5],
});
const portraitMobile = await getImage({
	src: me,
	format: "avif",
	width: 520,
	height: 724,
	densities: [1, 2],
});
const portraitFallback = await getImage({
	src: me,
	format: "jpg",
	width: 760,
	height: 1060,
});

const links = [
	{
		label: "GitHub",
		href: "https://github.com/MrFlashAccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "X",
		href: "https://twitter.com/mrflashaccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "Telegram",
		href: "https://t.me/mrflashaccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "CV",
		href: "/cv.pdf",
		download: "Sergei Garin CV.pdf",
	},
	{
		label: "Email",
		href: "mailto:job@garin.dev",
		itemProp: "email",
	},
];
---

<MainLayout>
	<main
		class="flex min-h-[100dvh] w-full items-center overflow-x-hidden bg-[#eee9df] px-0 py-0 text-[#f5f0e8] md:px-4 md:py-5"
	>
		<section
			class="relative mx-auto grid min-h-[100dvh] w-full min-w-0 max-w-full overflow-hidden bg-[#11100e] px-5 py-7 [corner-shape:superellipse(1.35)] md:min-h-[min(720px,calc(100dvh-4rem))] md:rounded-[2.5rem] md:px-12 md:py-11 md:shadow-[0_22px_70px_rgba(43,35,24,0.22)] lg:min-h-[640px] lg:max-w-6xl lg:px-16 lg:py-14"
			aria-labelledby="identity-title"
		>
			<picture class="pointer-events-none absolute inset-0 block">
				<source
					srcset={portraitDesktop.srcSet.attribute}
					media="(min-width: 860px)"
					type="image/avif"
				/>
				<source srcset={portraitMobile.srcSet.attribute} type="image/avif" />
				<img
					class="absolute bottom-0 right-[-8%] h-[66%] max-h-none w-auto max-w-none object-contain opacity-[0.34] md:right-[-2%] md:h-[92%] md:opacity-45 lg:right-[4%] lg:h-[108%] lg:opacity-60"
					src={portraitFallback.src}
					alt="Portrait of Sergei Garin"
					width={portraitFallback.attributes.width}
					height={portraitFallback.attributes.height}
					loading="eager"
					decoding="async"
				/>
			</picture>

			<div
				class="relative z-10 flex min-h-full min-w-0 max-w-[44rem] flex-col justify-end pt-32 md:pt-60 lg:pt-10"
			>
				<div class="mb-6 h-px w-12 bg-[#d8cdbc]/45 md:mb-7 md:w-16"></div>

				<h1
					id="identity-title"
					class="max-w-[9ch] text-[clamp(3.25rem,14.5vw,12.5rem)] font-semibold leading-[0.78] tracking-[-0.08em] text-[#fbf5eb] md:max-w-[9ch]"
					itemprop="name"
				>
					<span itemprop="givenName">Sergei</span>
					<span class="block" itemprop="familyName">Garin</span>
				</h1>

				<p
					class="mt-6 max-w-[13.5rem] text-[clamp(1.02rem,4vw,2.1rem)] font-semibold leading-[1.05] tracking-[-0.055em] text-[#f4ecde] md:mt-7 md:max-w-[34rem]"
				>
					Frontend engineer for sharp, reliable product interfaces.
				</p>

				<p
					class="mt-4 max-w-[13.75rem] text-base leading-7 tracking-[-0.025em] text-[#d8cdbc] md:text-lg md:leading-8"
				>
					I turn messy product ideas into calm, fast, production-ready UI.
				</p>

				<nav class="mt-8 md:mt-9" aria-label="Contact links">
					<ul
						class="flex max-w-[13.75rem] flex-col items-start gap-y-2 text-sm font-semibold tracking-[-0.015em] text-[#eee4d4] md:max-w-none md:flex-row md:flex-wrap md:items-center md:gap-y-3 md:text-base"
					>
						{
							links.map((link, index) => (
								<li class="flex items-center">
									{index > 0 && (
										<span
											class="mx-2 hidden h-4 w-px bg-[#d8cdbc]/35 md:mx-3 md:block"
											aria-hidden="true"
										/>
									)}
									<Link
										href={link.href}
										rel={link.rel}
										itemProp={link.itemProp}
										download={link.download}
										class="identity-link rounded-[0.35rem] px-1 py-0.5 text-[#f5ecdc] no-underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color,transform] duration-200 hover:text-white hover:decoration-[#f5ecdc] focus-visible:ring-[#f5ecdc] focus-visible:ring-offset-[#11100e] active:translate-y-px"
									>
										{link.label}
									</Link>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</section>
	</main>
</MainLayout>
