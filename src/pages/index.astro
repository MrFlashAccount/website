---
import { getImage } from "astro:assets";

import me from "../static/me.jpg";
import Link from "../components/link.astro";
import MainLayout from "../layouts/main.astro";

const portraitDesktop = await getImage({
	src: me,
	format: "avif",
	width: 760,
	height: 1060,
	densities: [1, 1.5],
});
const portraitMobile = await getImage({
	src: me,
	format: "avif",
	width: 520,
	height: 724,
	densities: [1, 2],
});
const portraitFallback = await getImage({
	src: me,
	format: "jpg",
	width: 760,
	height: 1060,
});

const links = [
	{
		label: "GitHub",
		href: "https://github.com/MrFlashAccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "X",
		href: "https://twitter.com/mrflashaccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "Telegram",
		href: "https://t.me/mrflashaccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "CV",
		href: "/cv.pdf",
		download: "Sergei Garin CV.pdf",
	},
	{
		label: "Email",
		href: "mailto:job@garin.dev",
		itemProp: "email",
	},
];
---

<MainLayout>
	<main
		class="min-h-[100dvh] w-full overflow-x-hidden bg-[#080807] text-[#f5f0e8]"
	>
		<section
			class="pb-safe xl:px-20 relative isolate mx-auto min-h-[100dvh] w-full max-w-[1180px] overflow-hidden px-6 py-8 sm:px-8 md:px-12 md:py-10 lg:px-16 lg:py-14"
			aria-labelledby="identity-title"
		>
			<picture
				class="pointer-events-none absolute inset-0 block"
				aria-hidden="true"
			>
				<source
					srcset={portraitDesktop.srcSet.attribute}
					media="(min-width: 860px)"
					type="image/avif"
				/>
				<source srcset={portraitMobile.srcSet.attribute} type="image/avif" />
				<img
					class="xl:right-[4%] absolute right-[-4%] top-0 h-[50%] max-h-none w-auto max-w-none object-contain opacity-[0.24] saturate-[0.82] sm:right-0 sm:h-[62%] md:right-[-4%] md:h-[76%] md:opacity-[0.32] lg:bottom-0 lg:right-0 lg:top-auto lg:h-[108%] lg:opacity-[0.58]"
					src={portraitFallback.src}
					alt=""
					width={portraitFallback.attributes.width}
					height={portraitFallback.attributes.height}
					loading="eager"
					decoding="async"
				/>
			</picture>

			<div
				class="lg:bg-[#080807]/24 absolute inset-0 bg-[#080807]/60"
				aria-hidden="true"
			>
			</div>

			<div
				class="relative z-10 flex min-h-[calc(100dvh-4rem)] max-w-[39rem] flex-col justify-start pt-1 md:min-h-[calc(100dvh-5rem)] md:max-w-[43rem] md:justify-center md:pt-0 lg:max-w-[52rem] lg:justify-end"
			>
				<div class="mb-6 h-px w-14 bg-[#d8cdbc]/55 md:mb-7 md:w-16"></div>

				<h1
					id="identity-title"
					class="max-w-[8.8ch] text-[clamp(4.6rem,22vw,7.4rem)] font-semibold leading-[0.78] tracking-[-0.085em] text-[#fbf5eb] lg:text-[clamp(7rem,11vw,12.5rem)]"
					itemprop="name"
				>
					<span itemprop="givenName">Sergei</span>
					<span class="block" itemprop="familyName">Garin</span>
				</h1>

				<p
					class="mt-7 max-w-[18rem] text-[clamp(1.2rem,5.4vw,2.1rem)] font-semibold leading-[1.08] tracking-[-0.055em] text-[#f3eadb] md:mt-8 md:max-w-[34rem] lg:max-w-[39rem]"
				>
					Frontend engineer for sharp, reliable product interfaces.
				</p>

				<p
					class="mt-4 max-w-[18.5rem] text-base leading-7 tracking-[-0.025em] text-[#d8cdbc] md:max-w-[31rem] md:text-lg md:leading-8"
				>
					I turn messy product ideas into calm, fast, production-ready UI.
				</p>

				<nav class="mt-8 md:mt-9" aria-label="Contact links">
					<ul
						class="flex max-w-[20rem] list-none flex-wrap items-center border-y border-[#d8cdbc]/20 py-3 text-sm font-semibold tracking-[-0.015em] text-[#eee4d4] md:max-w-none md:gap-y-3 md:border-0 md:py-0 md:text-base"
					>
						{
							links.map((link, index) => (
								<li class="flex items-center">
									{index > 0 && (
										<span
											class="mx-2 h-3 w-px bg-[#d8cdbc]/35 md:mx-3 md:h-4"
											aria-hidden="true"
										/>
									)}
									<Link
										href={link.href}
										rel={link.rel}
										itemProp={link.itemProp}
										download={link.download}
										class="identity-link block py-1.5 text-[#f5ecdc] no-underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color,transform] duration-200 hover:-translate-y-px hover:text-white hover:underline hover:decoration-[#f5ecdc] focus-visible:ring-[#f5ecdc] focus-visible:ring-offset-[#080807] active:translate-y-0 md:inline-block md:px-1 md:py-0.5"
									>
										{link.label}
									</Link>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</section>
	</main>
</MainLayout>
