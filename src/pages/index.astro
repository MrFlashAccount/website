---
import { getImage } from "astro:assets";

import me from "../static/me.jpg";
import Link from "../components/link.astro";
import MainLayout from "../layouts/main.astro";

const portraitDesktop = await getImage({
	src: me,
	format: "avif",
	width: 760,
	height: 1060,
	densities: [1, 1.5],
});
const portraitMobile = await getImage({
	src: me,
	format: "avif",
	width: 520,
	height: 724,
	densities: [1, 2],
});
const portraitFallback = await getImage({
	src: me,
	format: "jpg",
	width: 760,
	height: 1060,
});

const links = [
	{
		label: "GitHub",
		href: "https://github.com/MrFlashAccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "X",
		href: "https://twitter.com/mrflashaccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "Telegram",
		href: "https://t.me/mrflashaccount",
		rel: "me",
		itemProp: "sameAs",
	},
	{
		label: "CV",
		href: "/cv.pdf",
		download: "Sergei Garin CV.pdf",
	},
	{
		label: "Email",
		href: "mailto:job@garin.dev",
		itemProp: "email",
	},
];
---

<MainLayout>
	<main
		class="min-h-[100dvh] w-full overflow-x-hidden bg-[#080807] text-[#f5f0e8]"
	>
		<section
			class="pb-safe xl:px-20 relative isolate mx-auto min-h-[100dvh] w-full max-w-[1240px] overflow-hidden px-6 py-8 sm:px-8 md:px-12 md:py-10 lg:px-16 lg:py-14"
			aria-labelledby="identity-title"
		>
			<picture
				class="pointer-events-none absolute inset-0 block"
				aria-hidden="true"
			>
				<source
					srcset={portraitDesktop.srcSet.attribute}
					media="(min-width: 860px)"
					type="image/avif"
				/>
				<source srcset={portraitMobile.srcSet.attribute} type="image/avif" />
				<img
					class="xl:right-[4%] absolute right-[4%] top-[-1%] h-[48dvh] max-h-[30rem] min-h-[23rem] w-auto max-w-none object-contain opacity-[0.82] brightness-[1.16] contrast-[1.03] saturate-[0.92] sm:right-[2%] sm:h-[54dvh] md:right-[3%] md:h-[64dvh] lg:bottom-[-2%] lg:right-[1%] lg:top-auto lg:h-[104%] lg:max-h-none lg:opacity-[0.94]"
					src={portraitFallback.src}
					alt=""
					width={portraitFallback.attributes.width}
					height={portraitFallback.attributes.height}
					loading="eager"
					decoding="async"
				/>
			</picture>

			<div
				class="absolute inset-0 bg-[linear-gradient(180deg,rgba(8,8,7,0)_0%,rgba(8,8,7,0.16)_34%,#080807_64%)] sm:bg-[linear-gradient(180deg,rgba(8,8,7,0)_0%,rgba(8,8,7,0.18)_40%,#080807_70%)] lg:bg-[linear-gradient(90deg,#080807_0%,rgba(8,8,7,0.92)_31%,rgba(8,8,7,0.36)_58%,rgba(8,8,7,0)_100%)]"
				aria-hidden="true"
			>
			</div>

			<div
				class="relative z-10 flex min-h-[calc(100dvh-4rem)] max-w-[34rem] flex-col justify-start pb-2 pt-[35dvh] sm:pt-[38dvh] md:min-h-[calc(100dvh-5rem)] md:max-w-[42rem] md:pt-[34dvh] lg:min-h-[calc(100dvh-7rem)] lg:max-w-[46rem] lg:justify-center lg:pb-0 lg:pt-0"
			>
				<h1
					id="identity-title"
					class="max-w-[9.2ch] text-[clamp(4.15rem,18vw,6.4rem)] font-normal leading-[0.98] tracking-[-0.065em] text-[#fbf5eb] lg:text-[clamp(6.8rem,9.4vw,10.8rem)] lg:leading-[1]"
					itemprop="name"
				>
					<span itemprop="givenName">Sergei</span>
					<span class="block" itemprop="familyName">Garin</span>
				</h1>

				<p
					class="mt-6 max-w-[20rem] text-[clamp(1.18rem,4.8vw,1.72rem)] font-normal leading-[1.18] tracking-[-0.04em] text-[#f0e7d8] md:mt-7 md:max-w-[34rem] lg:max-w-[37rem] lg:text-[clamp(1.55rem,2.2vw,2.15rem)] lg:leading-[1.16]"
				>
					Frontend engineer for sharp, reliable product interfaces.
				</p>

				<p
					class="mt-3 max-w-[20rem] text-[0.98rem] leading-7 tracking-[-0.02em] text-[#d8cdbc] md:mt-4 md:max-w-[31rem] md:text-lg md:leading-8"
				>
					I turn messy product ideas into calm, fast,
					<span class="whitespace-nowrap">production-ready UI.</span>
				</p>

				<nav class="mt-7 md:mt-9" aria-label="Contact links">
					<ul
						class="flex max-w-[20rem] list-none flex-wrap items-center border-y border-[#d8cdbc]/20 py-3.5 text-sm font-normal tracking-[-0.015em] text-[#eee4d4] md:max-w-none md:gap-y-3 md:border-0 md:py-0 md:text-base"
					>
						{
							links.map((link, index) => (
								<li class="flex items-center">
									{index > 0 && (
										<span
											class="mx-2 h-3 w-px bg-[#d8cdbc]/35 md:mx-3 md:h-4"
											aria-hidden="true"
										/>
									)}
									<Link
										href={link.href}
										rel={link.rel}
										itemProp={link.itemProp}
										download={link.download}
										class="identity-link block py-1.5 text-[#f5ecdc] no-underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color,transform] duration-200 hover:-translate-y-px hover:text-white hover:underline hover:decoration-[#f5ecdc] focus-visible:ring-[#f5ecdc] focus-visible:ring-offset-[#080807] active:translate-y-0 md:inline-block md:px-1 md:py-0.5"
									>
										{link.label}
									</Link>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</section>
	</main>
</MainLayout>
